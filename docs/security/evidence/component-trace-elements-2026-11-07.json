    },
    "FIA_UAU.5.2": {
      "path": "dhis-2/dhis-services/dhis-service-core/src/main/java/org/hisp/dhis/security/spring2fa/TwoFactorAuthenticationProvider.java",
      "line": 171,
      "source_sha256": "d04d077df3b6ec1fbd76cf13f5a52a71ad3189d45b04dffe69b7de7c1ef23d8b",
      "observation": "The provider rejects unavailable/malformed enrolled factor types. Enabled login factors delegate to database-backed single-use validation before authentication can return. The delegated guard directly locks the primary user row and rejects a stale secret/type snapshot or deleted user at proof consumption. The consumption guard additionally requires a current matching password hash, enabled/local-login account state and non-expired account.",
      "limit": "Login-scoped provider correction only. Full AFTA provider-combination policy, other verification purposes, trusted clocks, recovery and deployed multi-node acceptance remain open. See ../afta-login-replay-protection.md. The 11 November freshness follow-up is traced in ../afta-factor-state-freshness.md. See ../afta-account-state-freshness.md for the bounded account-state follow-up."
    },
    "FPT_FLS.1.1": {
      "path": "dhis-2/dhis-services/dhis-service-core/src/main/java/org/hisp/dhis/security/twofa/TwoFactorReplayService.java",
